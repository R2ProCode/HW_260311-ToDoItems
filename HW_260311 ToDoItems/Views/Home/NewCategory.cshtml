<div class="card task-container mx-auto mt-5" style="max-width: 650px;">

    <div class="card-header">
        <h2 class="mb-0 fw-bold text-white">
            📁 New Category
        </h2>
    </div>

    <div class="card-body p-4">

        <form method="post" action="/home/addcategory">

            <div class="mb-4">

                <label for="categoryname"
                       class="form-label text-light fw-semibold">
                    Category Name
                </label>

                <input id="categoryname"
                       name="name"
                       type="text"
                       class="form-control form-control-lg"
                       placeholder="Enter category name..." />

            </div>

            <button type="submit"
                    class="btn btn-primary rounded-pill px-4 py-2 w-100">
                + Add Category
            </button>

        </form>

    </div>

</div>